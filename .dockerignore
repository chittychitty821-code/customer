.venv
__pycache__
.git
.pytest_cache
.vscode
*.pyc
*.pyo
# 1. Use an official lightweight Python base image
FROM python:3.11-slim

# 2. Prevent Python from buffering stdout/stderr and writing .pyc files
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# 3. Set the working directory inside the container
WORKDIR /app

# 4. Copy dependency file first to leverage Docker layer caching
COPY requirements.txt .

# 5. Upgrade pip and install all Python dependencies
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# 6. Copy the rest of the application files
COPY . .

# 7. Expose Railway's default dynamic port (informative)
EXPOSE 8080

# 8. Start the application
# Adjust "main.py" or the command to match your framework (examples below)
CMD ["python", "main.py"]
